[project]
requires = [ "nodejs-24" ]
project_type = "web"
template = "custom"

[dev]
build = [ "pnpm", "install" ]
run = ["sh", "-c", "NODE_ENV=development npx taro build --type h5 --watch --port ${DEPLOY_RUN_PORT:-5000}"]
deps = [ "git" ]

[deploy]
build = [ "bash", "-c", "pnpm install && pnpm run build:h5" ]
run = ["sh", "-c", "npx serve dist -l ${DEPLOY_RUN_PORT:-5000}"]
deps = [ "git" ]
