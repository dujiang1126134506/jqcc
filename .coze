[project]
requires = [ "nodejs-24" ]
project_type = "web"
template = "custom"

[dev]
build = ["sh", "-c", "pnpm install --no-frozen-lockfile && pnpm run build"]
run = ["sh", "-c", "npx serve dist -l ${DEPLOY_RUN_PORT:-5000} -s -n"]

[deploy]
build = ["sh", "-c", "pnpm install --no-frozen-lockfile && pnpm run build"]
run = ["sh", "-c", "npx serve dist -l ${DEPLOY_RUN_PORT:-5000} -s -n"]
