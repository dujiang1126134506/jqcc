[project]
requires = [ "nodejs-24" ]
project_type = "web"
template = "custom"

[dev]
build = ["sh", "-c", "pnpm install --no-frozen-lockfile && NODE_ENV=production npx taro build --type h5"]
run = ["sh", "-c", "npx serve dist -l ${DEPLOY_RUN_PORT:-5000} -s"]
deps = [ "git" ]

[deploy]
build = ["bash", "-c", "pnpm install --no-frozen-lockfile && pnpm run build:h5"]
run = ["sh", "-c", "npx serve dist -l ${DEPLOY_RUN_PORT:-5000} -s"]
deps = [ "git" ]
